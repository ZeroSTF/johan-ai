{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Johan's 35B (local llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:8092/v1"
      },
      "models": {
        "qwen36": {
          "name": "Qwen3.6-35B-A3B",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "model": "llama.cpp/qwen36",
  "small_model": "llama.cpp/qwen36",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "johan": {
      "type": "local",
      "command": [
        "/home/zeros/johan/venv-embed/bin/python3",
        "/home/zeros/johan/scripts/johan_mcp.py"
      ],
      "enabled": true,
      "timeout": 600000
    }
  }
}
